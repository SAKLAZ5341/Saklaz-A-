# SAKLAZ Gateway ornek ortam degiskenleri. Gercek degerleri .env dosyasina veya
# barindirma platformunun "secret" ayarlarina yazin. .env ASLA commit edilmez.

# --- Zorunlu ---
# OpenAI anahtari YALNIZCA burada durur; uygulamaya/APK'ya asla konmaz.
OPENAI_API_KEY=
# Varsayilan model. Guncel model adini OpenAI dokumantasyonundan dogrulayin.
SAKLAZ_DEFAULT_MODEL=gpt-5-mini
# Uygulamanin secebilecegi modeller (virgulle). Pahali modelleri eklemeyin.
SAKLAZ_ALLOWED_MODELS=gpt-5-mini
# Cihaz token ozetleri (virgulle). Uretmek icin: npm run new-token
SAKLAZ_DEVICE_TOKEN_HASHES=

# --- Maliyet kontrolu ---
SAKLAZ_DAILY_BUDGET_USD=1
# Varsayilan modelin 1 milyon token fiyati (USD). OpenAI fiyat sayfasindan girin.
# 0 birakilirsa butce kontrolu calismaz (yalnizca istek sayisi sinirlanir).
SAKLAZ_PRICE_INPUT_PER_MTOK_USD=0
SAKLAZ_PRICE_OUTPUT_PER_MTOK_USD=0
SAKLAZ_MAX_OUTPUT_TOKENS=600

# --- Istek sinirlari ---
SAKLAZ_REQUESTS_PER_MINUTE=10
SAKLAZ_DAILY_REQUEST_LIMIT=200

# --- Istege bagli ---
# Guncel bilgi sorulari icin OpenAI web aramasi (ek maliyet).
SAKLAZ_ALLOW_WEB_SEARCH=false
PORT=8787
HOST=0.0.0.0
